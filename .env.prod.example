# EC2 서버에서 `cp .env.prod.example .env`로 복사한 뒤 값을 채운다. 이 파일에 실제 값을 넣어 커밋하지 않는다.

# EC2 공인 IP의 점(.)을 하이픈(-)으로 바꾼 nip.io 주소. 예: 13.125.10.20 → 13-125-10-20.nip.io
DOMAIN=

# DB 비밀번호. URL에 들어가므로 영문·숫자만 사용한다 (생성: openssl rand -hex 16)
POSTGRES_PASSWORD=

# 32자 이상 무작위 문자열. 개발용과 다른 값을 쓴다 (생성: openssl rand -hex 32)
SESSION_SECRET=

# Codyssey Neito API 키
AI_API_KEY=